# Supabase Configuration
# Get these values from https://supabase.com/dashboard/project/[your-project]/settings/api

# Your Supabase project URL (example: https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase public anon key (starts with eyJh...)
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
